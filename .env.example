# Valeurs local (hors Docker), via le port publié de la db.
# Dans docker compose, ces valeurs sont override par les var d'env des compose (DB_HOST=db, DB_PORT=3306 -> appels par nom de conteneur)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=mdp
DB_NAME=clinique
PYTHON_PATH=python3
PORT=3000
CORS_ORIGINS=http://localhost:4200,http://localhost:8080